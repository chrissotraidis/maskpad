+void ConnectedPhysicalDeviceManager::AssignNewGamepadToFirstFreePort(int32_t instanceId) {
+    for (uint8_t port = 0; port < kPortCount; port++) {
+        mIgnoredInstanceIds[port].insert(instanceId);
+    }
+
+    for (uint8_t port = 0; port < kPortCount; port++) {
+        bool occupied = false;
+        for (const auto& [otherInstanceId, gamepad] : mConnectedSDLGamepads) {
+            if (otherInstanceId != instanceId && !PortIsIgnoringInstanceId(port, otherInstanceId) &&
+                GamepadHandleIsCurrent(otherInstanceId, gamepad)) {
+                occupied = true;
+                break;
+            }
+        }
+        if (!occupied) {
+            mIgnoredInstanceIds[port].erase(instanceId);
+            SPDLOG_INFO("Controller assignment: instance={} player-slot={}", instanceId, port + 1);
+            return;
+        }
