@@ -428,6 +428,14 @@ void RunFrame() {

 void Graph_ThreadEntry(void* arg0) {
     while (WindowIsRunning()) {
+#ifdef __IOS__
+        // UIKit can leave the app inactive while system UI, such as the screenshot editor, is open.
+        // Rendering is suspended during that interval, so pause simulation as well instead of running unpaced.
+        WindowWaitForFrameReady();
+        if (!WindowIsRunning()) {
+            break;
+        }
+#endif
         RunFrame();
     }
 }
